# ==============================================================================
# DYELDI - VARIÁVEIS DE AMBIENTE (ARQUIVO DE EXEMPLO PÚBLICO)
#
# INSTRUÇÕES DE SEGURANÇA:
# 1. NUNCA faça commit do arquivo .env com credenciais reais para o GitHub.
# 2. Copie este arquivo para .env (`cp .env.example .env`) e preencha com suas chaves.
# 3. Mantenha chaves com permissões restritas e rotacione-as periodicamente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIÇOS DE BACKEND & APIS EXTERNAS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Chave de API do Google Gemini para recursos de IA e análise.
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"

# BRAPI_API_KEY: Token da brapi.dev para cotações de Ações e FIIs da B3 em tempo real.
# Obtenha gratuitamente em: https://brapi.dev
BRAPI_API_KEY="SEU_TOKEN_BRAPI_AQUI"

# BOLSAI_API_KEY: Chave da Bolsai API para projeções de dividendos e histórico.
BOLSAI_API_KEY="SUA_CHAVE_BOLSAI_AQUI"

# COINGECKO_API_KEY: (Opcional) Chave Demo da CoinGecko para cotações de criptoativos sem rate-limit público.
COINGECKO_API_KEY=

# ADMIN_SECRET: Token secreto para proteger endpoints administrativos (ex: /api/admin/* e /api/cron/*)
ADMIN_SECRET="INSIRA_UM_TOKEN_SECRETO_SEGURO_AQUI"

# APP_URL: URL base pública da aplicação (utilizada para links absolutos e webhooks)
APP_URL="http://localhost:3000"

# PORT: Porta local do servidor Node.js / Express (padrão: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTH & FIRESTORE (CLIENT-SIDE VITE_*)
# ------------------------------------------------------------------------------
# Configure estas variáveis com o projeto Firebase que você criar para seu ambiente:
# Obtenha no Console do Firebase > Configurações do Projeto > Seus Aplicativos (Web)

VITE_FIREBASE_API_KEY="AIzaSy_SUA_CHAVE_FIREBASE_CLIENTE"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-firebase"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 3. DADOS PÚBLICOS DE SUPORTE & COMUNIDADE (OPCIONAL)
# ------------------------------------------------------------------------------
# Configure chaves públicas ou canais institucionais se desejar receber doações / suporte
VITE_SUPPORT_PIX_KEY="chave-pix@exemplo.com"
VITE_SUPPORT_PIX_NAME="Dyeldi Open Source"
VITE_SUPPORT_WHATSAPP=""
VITE_SUPPORT_EMAIL="suporte@exemplo.com"
